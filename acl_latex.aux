\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mean score on ground-truth candidates ($p_{gt}$, filled bars) vs.\ non-relevant candidates ($p_{\neg gt}$, hatched bars), averaged per language under the same windowed protocol. A wider gap indicates better discrimination between gold and non-gold. Fine-tuning widens the separation at every model size: the base 0.5B model is actively mis-calibrated --- it assigns $p_{\neg gt} > p_{gt}$ in every language --- whereas the fine-tuned 3B variant achieves a separation comparable to GPT-5.3 Codex, with $p_{gt}$ above $p_{\neg gt}$ by a margin of $0.25$--$0.45$.}}{12}{figure.caption.45}\protected@file@percent }
\newlabel{fig:scorer-score-separation}{{4}{12}{Mean score on ground-truth candidates ($p_{gt}$, filled bars) vs.\ non-relevant candidates ($p_{\neg gt}$, hatched bars), averaged per language under the same windowed protocol. A wider gap indicates better discrimination between gold and non-gold. Fine-tuning widens the separation at every model size: the base 0.5B model is actively mis-calibrated --- it assigns $p_{\neg gt} > p_{gt}$ in every language --- whereas the fine-tuned 3B variant achieves a separation comparable to GPT-5.3 Codex, with $p_{gt}$ above $p_{\neg gt}$ by a margin of $0.25$--$0.45$}{figure.caption.45}{}}
\@LN@col{1}
